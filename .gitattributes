# Normalize repository text to UTF-8-compatible LF. Binary assets are never text-converted.
* text=auto

*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.sh text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.jar binary
*.war binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
