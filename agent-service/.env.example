AGENT_APP_NAME=Qinghe Campus Assistant
AGENT_ENV=development
AGENT_HOST=127.0.0.1
AGENT_PORT=8100
AGENT_LOG_LEVEL=INFO
AGENT_MOCK_MODE=true
AGENT_TOOL_MODE=mock

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=1024

# Token governance defaults use safe tokenizer-independent estimates. Prices remain zero unless safe profile configuration supplies them.
AGENT_TOKEN_BUDGET_ENABLED=true
AGENT_DEFAULT_CONTEXT_LIMIT=8192
AGENT_MAX_INPUT_TOKENS=6000
AGENT_MAX_OUTPUT_TOKENS=800
AGENT_HISTORY_MAX_TURNS=6
AGENT_TOOL_SCHEMA_MAX_COUNT=4
AGENT_TOOL_RESULT_MAX_TOKENS=1500
AGENT_CONVERSATION_MAX_TOKENS=30000
AGENT_TOKEN_BUDGET_WARNING_RATIO=0.8
AGENT_FAST_PROFILE_ENABLED=true
AGENT_STANDARD_PROFILE_ENABLED=true
AGENT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AGENT_CIRCUIT_BREAKER_RECOVERY_SECONDS=30
AGENT_CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=1
AGENT_PUBLIC_CACHE_ENABLED=false
AGENT_PUBLIC_CACHE_TTL_SECONDS=30
AGENT_PUBLIC_CACHE_MAX_ENTRIES=500

# Disabled by default. Only development/test may explicitly fall back after a provider failure.
AGENT_PROVIDER_FALLBACK_ENABLED=false
AGENT_PROVIDER_FALLBACK=deterministic

AGENT_CONVERSATION_MAX_TURNS=10
AGENT_CONVERSATION_TTL_MINUTES=30
AGENT_CONVERSATION_MAX_COUNT=1000
AGENT_RATE_LIMIT_PER_MINUTE=30
AGENT_MAX_CONCURRENT_REQUESTS=20
AGENT_MAX_CONCURRENT_MODEL_CALLS=5
AGENT_MAX_CONCURRENT_TOOL_CALLS=10
AGENT_MAX_SSE_CONNECTIONS=20

QINGHE_BACKEND_ENABLED=false
QINGHE_BACKEND_BASE_URL=http://127.0.0.1:8090
QINGHE_CONNECT_TIMEOUT_SECONDS=2
QINGHE_READ_TIMEOUT_SECONDS=5
QINGHE_WRITE_TIMEOUT_SECONDS=5
QINGHE_POOL_TIMEOUT_SECONDS=2
QINGHE_MAX_RETRIES=1

AGENT_ALLOWED_ORIGINS=http://localhost:5174
