AGENT_ENV=development
AGENT_HOST=127.0.0.1
AGENT_PORT=8100

# OpenAI-compatible model with mock Tools: no Java, MySQL, or Redis connection.
AGENT_MOCK_MODE=false
AGENT_TOOL_MODE=mock
QINGHE_BACKEND_ENABLED=false

# Set LLM_API_KEY only in the invoking PowerShell session or ignored .env file.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=0
LLM_MAX_TOKENS=384

# Keep all profiles local/placeholder-only until separately authorized real-model validation.
AGENT_TOKEN_BUDGET_ENABLED=true
AGENT_DEFAULT_CONTEXT_LIMIT=8192
AGENT_MAX_INPUT_TOKENS=4000
AGENT_MAX_OUTPUT_TOKENS=384
AGENT_HISTORY_MAX_TURNS=3
AGENT_TOOL_SCHEMA_MAX_COUNT=1
AGENT_TOOL_RESULT_MAX_TOKENS=800
AGENT_CONVERSATION_MAX_TOKENS=30000
AGENT_TOKEN_BUDGET_WARNING_RATIO=0.8
AGENT_FAST_PROFILE_ENABLED=true
AGENT_STANDARD_PROFILE_ENABLED=true
AGENT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AGENT_CIRCUIT_BREAKER_RECOVERY_SECONDS=30
AGENT_CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=1
AGENT_PUBLIC_CACHE_ENABLED=false
AGENT_PUBLIC_CACHE_TTL_SECONDS=30
AGENT_PUBLIC_CACHE_MAX_ENTRIES=500

AGENT_PROVIDER_FALLBACK_ENABLED=false
AGENT_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
